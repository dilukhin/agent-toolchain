{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "apiKey": "{file:__ROUTERAI_API_KEY_FILE__}"
      },
      "models": {
        "openai/gpt-4o": {
          "name": "OpenAI GPT-4o [дорогая универсальная, 273/1093 ₽]"
        },
        "openai/gpt-4o-mini": {
          "name": "OpenAI GPT-4o mini [дешёвая быстрая, 16/66 ₽]"
        },
        "deepseek/deepseek-chat": {
          "name": "DeepSeek Chat [дешёвая code/chat, 35/97 ₽]"
        },
        "anthropic/claude-opus-4.7": {
          "name": "Anthropic Claude Opus 4.7 [топ код/агент, 546/2732 ₽]"
        },
        "qwen/qwen3.6-plus": {
          "name": "Qwen 3.6 Plus [основная, 36/213 ₽]"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro [reasoning, 146/292 ₽]"
        },
        "minimax/minimax-m2.7": {
          "name": "MiniMax M2.7 [дешёвая, 23/92 ₽]"
        },
        "z-ai/glm-5": {
          "name": "GLM-5 [архитектор, 66/210 ₽]"
        },
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5 [агентная, 49/246 ₽]"
        },
        "z-ai/glm-5-turbo": {
          "name": "GLM-5 Turbo [fallback, 131/437 ₽]"
        },
        "openai/gpt-5.2-codex": {
          "name": "GPT-5.2-Codex [код/агент, 191/1530 ₽]"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen 3 Coder Next [код/агент, 13/87 ₽]"
        },
        "qwen/qwen3.5-122b-a10b": {
          "name": "Qwen 3.5 122B A10B [мультимод. reasoning, 28/227 ₽]"
        }
      }
    }
  },
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "build": {
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "luna": {
      "model": "openai/gpt-5.6-luna"
    },
    "luna-safe-worker": {
      "model": "openai/gpt-5.6-luna"
    },
    "sol-specialist": {
      "model": "openai/gpt-5.6-sol"
    },
    "astra-reviewer": {
      "model": "openai/gpt-6-astra"
    }
  }
}
