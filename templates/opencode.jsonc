{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "provider": {
    "routerai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RouterAI",
      "options": {
        "baseURL": "https://routerai.ru/api/v1",
        "apiKey": "{file:__ROUTERAI_API_KEY_FILE__}"
      },
      "models": {
        "openai/gpt-4o": {
          "name": "OpenAI GPT-4o [дорогая универсальная, 280/1120 ₽]"
        },
        "openai/gpt-4o-mini": {
          "name": "OpenAI GPT-4o mini [дешёвая быстрая, 17/67 ₽]"
        },
        "deepseek/deepseek-chat": {
          "name": "DeepSeek Chat [дешёвая code/chat, 36/100 ₽]"
        },
        "anthropic/claude-opus-4.7": {
          "name": "Anthropic Claude Opus 4.7 [топ код/агент, 560/2801 ₽]"
        },
        "qwen/qwen3.6-plus": {
          "name": "Qwen 3.6 Plus [основная, 36/218 ₽]"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro [reasoning, 188/188 ₽]"
        },
        "minimax/minimax-m2.7": {
          "name": "MiniMax M2.7 [дешёвая, 24/94 ₽]"
        },
        "z-ai/glm-5": {
          "name": "GLM-5 [архитектор, 67/215 ₽]"
        },
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5 [агентная, 50/252 ₽]"
        },
        "z-ai/glm-5-turbo": {
          "name": "GLM-5 Turbo [fallback, 134/448 ₽]"
        },
        "openai/gpt-5.2-codex": {
          "name": "GPT-5.2-Codex [код/агент, 196/1569 ₽]"
        },
        "qwen/qwen3-coder-next": {
          "name": "Qwen 3 Coder Next [код/агент, 13/90 ₽]"
        },
        "qwen/qwen3.5-122b-a10b": {
          "name": "Qwen 3.5 122B A10B [мультимод. reasoning, 29/233 ₽]"
        }
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/gpt-5-nano"
}
