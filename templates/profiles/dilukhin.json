{
  "profile_schema": 1,
  "name": "dilukhin",
  "description": "Explicit author distribution policy preserving the pre-profile agent-toolchain defaults.",
  "routerai": {
    "enabled": true,
    "template": "templates/profiles/dilukhin/opencode.jsonc",
    "policy": "templates/profiles/dilukhin/routerai_model_policy.json"
  },
  "global_environment": {
    "agents": true,
    "remote_long_running": true
  },
  "settings": {
    "provider_name": "RouterAI",
    "npm_package": "@ai-sdk/openai-compatible",
    "base_url": "https://routerai.ru/api/v1"
  },
